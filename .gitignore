# ---- Python ----
server/.venv/
server/.venv-build/
__pycache__/
*.py[cod]

# ---- Android / Gradle ----
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.iml
*.apk
*.aab

# ---- 运行时产物（测试数据、日志，都不是源码）----
server/uploads/
server/test.bin
server-serverlog.txt

# ---- Nuitka 打包产物（server/build 是最终 exe，另外三个是中间目录）----
server/build/
server/*.build/
server/*.dist/
server/*.onefile-build/

# Nuitka 的缓存目录：%LOCALAPPDATA%\Nuitka 在这台机器上不可写，用 NUITKA_CACHE_DIR 指到了这里
.nuitka-cache/

# 编译期的临时目录：系统的 %TEMP% 不可写（gcc 链接时报 Error 3），把 TEMP/TMP 指到了这里
.tmp/
nuitka-crash-report.xml

# Nuitka onefile 运行时的解压目录：exe 从哪个目录启动就在哪建一个（双击运行就是 exe 旁边）
LocalConnect_tmp/

# 用 tools/ 下脚本生成的测试图片（推送到模拟器相册用的），不是项目资源
tools/test-images/

# 服务端测试用的图片
server/test/

# ---- 编辑器 ----
.vscode/
.idea/

# ---- 系统 ----
Thumbs.db
Desktop.ini
